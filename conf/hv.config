[host]
pcpus = 1
max_vms = 4
max_ticks = 5000
seed = 2026

[sched]
policy = LOTTERY
quantum = 5

[mem]
model = PAG
phys_words = 1024
page_words = 64
replacement = NRU
repl_scope = LOCAL
pf_penalty = 3

[io]
disk_algorithm = LOOK
disk_cylinders = 200
disk_head = 50
seek_rate = 25

[log]
format = JSONL
level = INFO
file = out/minihv.jsonl

[ext]
enabled = true
dir = out/snapshots